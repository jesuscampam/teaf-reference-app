# Configuration for TEAF Reference App.
# Copy this file to `.env` and adjust as needed.

APP_NAME=TEAF Reference App
APP_VERSION=0.4.0-alpha
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Where the Task Manager stores its tasks. Relative paths resolve against
# the directory you start the app from. `:memory:` gives a throwaway
# database that is discarded on shutdown.
TASK_DATABASE_PATH=tasks.db

# -- Demo authentication ------------------------------------------------------
# This is a DEMONSTRATION login, not identity management. See the README.

# HS256 signing key. Leave empty and the app generates a random one at
# startup — there is no shipped secret to leak. Set it to keep sessions
# alive across restarts; TEAF rejects anything under 32 bytes (RFC 7518).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET=

# Demo accounts, hashed with Argon2id at startup. `demo` can read and
# write; `viewer` can only read, so mutating endpoints answer 403 for it.
AUTH_DEMO_USERNAME=demo
AUTH_DEMO_PASSWORD=demo1234
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=viewer1234

# How long an access token lasts. There is no refresh flow in the UI, so
# this is how long a browser session lives before login is needed again.
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
